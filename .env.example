MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/gatesathi?retryWrites=true&w=majority
AUTH_SECRET=replace-with-32-byte-secret-from-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# OTP Provider ('mock' requires ALLOW_MOCK_OTP=true; 'msg91' in production)
OTP_MODE=mock
ALLOW_MOCK_OTP=true
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Cloudflare R2 Private Bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=gatesathi-private

# Cron Job Authentication
CRON_SECRET=replace-with-strong-cron-secret

# Web Push (VAPID) — generate via: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@gatesathi.in

# Public Demo Showcase & Test Credentials Banner ('true' only for demo environments; default off)
NEXT_PUBLIC_DEMO_MODE=false
